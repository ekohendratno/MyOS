# packages.list — Paket tambahan mixos (MINIMAL BUILD)
# Target: ISO ringkas, hanya yang penting untuk daily use.
# Yang bisa ditunda tidak dimasukkan — install manual nanti.

# === Live System (wajib) ===
live-boot
live-config
live-config-systemd

# === Base Tools ===
ca-certificates
curl
file
git
gnupg
less
nano
rsync
tar
unzip
wget
zip
xdg-utils

# === Browser ===
chromium
chromium-l10n
firefox-esr

# === Archive ===
file-roller

# === Network ===
network-manager
network-manager-gnome
wpasupplicant
wireless-tools

# === Fonts (minimal) ===
fonts-inter-variable
fonts-dejavu-core
fonts-liberation2

# === Utilities (penting untuk daily use) ===
dbus-x11                  # session bus for X11 desktop sessions
dconf-cli                # needed for dconf update in build hooks
gnome-calculator
gnome-console            # terminal
gnome-disk-utility       # kelola USB/format disk
gnome-logs
gnome-text-editor
gnome-screenshot         # screenshot cepat
gnome-system-monitor     # task manager
gnome-tweaks
htop
iputils-ping
net-tools
openssh-client
pciutils
usbutils
evince                   # PDF viewer
libxcb-cursor0           # required by Qt xcb platform plugin
x11-utils
xwallpaper                # paint wallpaper when Lingmo desktop does not apply it yet
plank                    # fallback dock if lingmo-dock crashes during live session
xterm                    # emergency fallback if Lingmo shell fails

# === Multimedia (ringan) ===
eog                      # image viewer
